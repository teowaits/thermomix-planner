# Cookidoo credentials
COOKIDOO_EMAIL=your@email.com
COOKIDOO_PASSWORD=yourpassword
COOKIDOO_COUNTRY=it
COOKIDOO_LANGUAGE=it-IT

# CORS — set to your NAS hostname or IP:port for NAS deployment
# Use * for local dev, specific origin to restrict access
CORS_ORIGINS=http://nas.local:8080

# App port on the host (default 8080)
APP_PORT=8080

# Claude API key — optional. Used for multilingual ingredient synonym resolution.
# If absent: unknown ingredients are not resolved via Claude; the app works normally.
ANTHROPIC_API_KEY=

# HTTP Basic Auth (shared household password)
BASIC_AUTH_USER=planner
BASIC_AUTH_PASS=changeme
