# Cookidoo credentials — copy this file to .env and fill in your values.
# WARNING: incorrect credentials will cause the server to crash on startup (intentional).
# .env is gitignored — never commit it.

COOKIDOO_EMAIL=your.email@example.com
COOKIDOO_PASSWORD=your_password

# Locale — defaults are for cookidoo.it (Italian account).
# country_code and language must be a valid pair from the cookidoo-api localization list.
# See: https://miaucl.github.io/cookidoo-api/localization/
COOKIDOO_COUNTRY=it
COOKIDOO_LANGUAGE=it-IT

# Claude API key — optional. Used for multilingual ingredient synonym resolution.
# If absent: unknown ingredients are not resolved via Claude; the app works normally.
# Ingredients in the built-in dictionary (backend/data/ingredient_synonyms.json)
# are resolved without an API key regardless.
ANTHROPIC_API_KEY=
